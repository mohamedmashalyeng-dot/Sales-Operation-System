NODE_ENV=production
PORT=3000
TZ=Africa/Cairo
API_TIMING_WARN_MS=1000
API_PERF_TRACE=false
API_DEBUG_ENDPOINTS=false
BACKGROUND_JOBS_ENABLED=true

# Optional real database storage.
# Leave DATABASE_URL empty to keep using data/pathway-db.json locally.
# Supported connection strings:
# - Neon/PostgreSQL: postgresql://...
# - MongoDB: mongodb://... or mongodb+srv://...
DATABASE_URL=
DATABASE_NAME=pathway
POSTGRES_STATE_TABLE=app_state
POSTGRES_USERS_TABLE=app_users
POSTGRES_LOGIN_EVENTS_TABLE=app_login_events
POSTGRES_PASSWORD_RESETS_TABLE=app_password_resets
POSTGRES_SESSIONS_TABLE=app_sessions
POSTGRES_POOL_MAX=10
POSTGRES_POOL_WARM_CONNECTIONS=2
POSTGRES_POOL_IDLE_TIMEOUT_MS=600000
POSTGRES_POOL_CONNECTION_TIMEOUT_MS=10000
SESSION_AUTH_CACHE_MS=60000
LEAD_SOFT_DELETE_ENABLED=false
AUTO_CREATE_APPLICATIONS_FOR_ENROLLED_LEADS=true
ENROLLED_LEAD_APPLICATION_BACKFILL=true
ENROLLED_LEAD_APPLICATION_BACKFILL_LIMIT=50000
MONGO_STATE_COLLECTION=app_state
SKIP_SCHEMA_SETUP=false
MONITORING_STATEMENT_TIMEOUT_MS=5000
EMAIL_LIST_STATEMENT_TIMEOUT_MS=5000
MONITORING_SNAPSHOT_ENABLED=true
MONITORING_SNAPSHOT_PROACTIVE_ENABLED=true
MONITORING_SNAPSHOT_TTL_MS=120000
MONITORING_SNAPSHOT_REFRESH_INTERVAL_MS=60000

# Used only when the database is empty and the backend creates the first account.
INITIAL_ADMIN_NAME=Kent Alteam
INITIAL_ADMIN_EMAIL=mohamedmashalyeng@gmail.com
INITIAL_ADMIN_ROLE=admin
INITIAL_ADMIN_PASSWORD=change-this-before-live
DEV_PANEL_NAME=Developer
DEV_PANEL_EMAIL=mohamedmashalyeng@gmail.com
DEV_PANEL_ROLE=admin
DEV_PANEL_PASSWORD=change-this-before-live
DEV_PANEL_FORCE_PASSWORD=true

BOOTSTRAP_LEAD_LIMIT=25
BOOTSTRAP_TASK_LIMIT=25
BOOTSTRAP_EMAIL_LIMIT=50
BOOTSTRAP_EVENT_LIMIT=10
BOOTSTRAP_AUDIT_LIMIT=25

GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REDIRECT_URI=https://your-domain.com/api/integrations/gmail/callback
GMAIL_AUTO_SYNC=true
GMAIL_IMPORT=true
GMAIL_INCREMENTAL_ONLY=true
GMAIL_AUTO_SYNC_MODE=interval
GMAIL_AUTO_SYNC_DAILY_TIME=18:00
GMAIL_AUTO_SYNC_DAILY_BATCHES=20
GMAIL_AUTO_SYNC_BATCH_SIZE=25
GMAIL_AUTO_SYNC_ACTIVE_MS=3600000
GMAIL_AUTO_SYNC_IDLE_MS=3600000
GMAIL_TRASH_SYNC_LIMIT=10
GMAIL_TRASH_SYNC_INTERVAL_MS=3600000

# For password reset emails. With Gmail, use an App Password, not your normal Gmail password.
GMAIL_SMTP_USER=your-gmail-address@gmail.com
GMAIL_SMTP_PASS=your-gmail-app-password
GMAIL_SMTP_HOST=smtp.gmail.com
SMTP_HELO=localhost
MAIL_FROM_NAME=Kent Business College
MAIL_FROM=your-gmail-address@gmail.com

EVENT_AUTO_SYNC=true
EVENT_AUTO_SYNC_INTERVAL_MS=600000
EVENT_AUTO_SYNC_MAX_EVENTS=10
EVENTBRITE_DELETE_SCAN_PAGES=10
EVENTS_INCREMENTAL_ONLY=false
EVENTS_SHEET_URL=
EVENTBRITE_CLIENT_ID=your-eventbrite-api-key
EVENTBRITE_CLIENT_SECRET=your-eventbrite-client-secret
EVENTBRITE_REDIRECT_URI=https://your-domain.com/api/integrations/eventbrite/callback

# Optional fallback if Eventbrite OAuth pages are blocked for you.
# Create/copy a private OAuth token from Eventbrite and the app can sync directly.
EVENTBRITE_PRIVATE_TOKEN=your-eventbrite-private-token

ZOOM_ACCOUNT_ID=your-zoom-account-id
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret
ZOOM_ACCOUNT_LABEL=Zoom account 1
ZOOM_ACCOUNT_ID_2=your-second-zoom-account-id
ZOOM_CLIENT_ID_2=your-second-zoom-client-id
ZOOM_CLIENT_SECRET_2=your-second-zoom-client-secret
ZOOM_ACCOUNT_LABEL_2=Zoom account 2
ZOOM_USER_ID=me
ZOOM_MEETING_TYPE=all
ZOOM_INCLUDE_HISTORY=true
ZOOM_REPORT_HISTORY_MONTHS=6
ZOOM_REPORT_SYNC_OVERLAP_DAYS=7
ZOOM_HISTORY_FROM=
ZOOM_SYNC_ALL_USERS=true
ZOOM_MAX_USERS=100
ZOOM_MAX_MEETINGS=2000
ZOOM_AUTO_SYNC=true
ZOOM_AUTO_SYNC_MEETINGS=true
ZOOM_AUTO_SYNC_CALLS=true
ZOOM_AUTO_SYNC_INTERVAL_MS=600000
ZOOM_AUTO_SYNC_MAX_MEETINGS=500
ZOOM_AUTO_SYNC_MAX_CALLS=250
ZOOM_IMPORT_PARTICIPANTS=true
ZOOM_IMPORT_PAST_PARTICIPANTS=false
ZOOM_MAX_PARTICIPANTS_PER_MEETING=300
ZOOM_MAX_REGISTRANT_MEETING_LOOKUPS=20
ZOOM_CALL_HISTORY_MONTHS=3
ZOOM_MAX_CALLS=1000
ZOOM_REQUEST_DELAY_MS=350

META_ACCESS_TOKEN=your-meta-page-access-token
META_PAGE_ID=your-facebook-page-id
# Optional comma-separated form IDs. Leave empty to sync all lead forms on the page.
META_FORM_IDS=
META_GRAPH_VERSION=v22.0

APOLLO_API_KEY=your-apollo-api-key
# Optional comma-separated People Search filters.
APOLLO_KEYWORDS=apprenticeships training marketing project management
APOLLO_PERSON_TITLES=Marketing Manager,Sales Director,HR Manager,Learning and Development Manager
APOLLO_PERSON_LOCATIONS=United Kingdom
APOLLO_PER_PAGE=25

ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REDIRECT_URI=https://your-domain.com/api/integrations/zoho/callback
ZOHO_AUTH_ACCOUNTS_URL=https://accounts.zoho.com
# Confirm the correct accounts/API domain for the Zoho client data center.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com
ZOHO_SCOPES=ZohoCRM.modules.leads.READ,ZohoCRM.modules.contacts.READ,ZohoCRM.modules.accounts.READ,ZohoCRM.modules.deals.READ,ZohoCRM.modules.tasks.READ,ZohoCRM.modules.calls.READ,ZohoCRM.modules.events.READ,ZohoCRM.modules.campaigns.READ,ZohoCRM.modules.notes.READ,ZohoCRM.users.READ
ZOHO_SYNC_MODULES=Leads,Contacts,Accounts,Deals,Tasks,Calls,Events,Campaigns,Notes
ZOHO_SYNC_BATCH_SIZE=200
ZOHO_SYNC_CONCURRENCY=2
ZOHO_SYNC_POLL_INTERVAL_MS=2500
