NODE_ENV=production
PORT=3000

# Optional real database storage.
# Leave DATABASE_URL empty to keep using data/pathway-db.json locally.
# Supported connection strings:
# - Neon/PostgreSQL: postgresql://...
# - MongoDB: mongodb://... or mongodb+srv://...
DATABASE_URL=
DATABASE_NAME=pathway
POSTGRES_STATE_TABLE=app_state
POSTGRES_USERS_TABLE=app_users
POSTGRES_LOGIN_EVENTS_TABLE=app_login_events
POSTGRES_PASSWORD_RESETS_TABLE=app_password_resets
MONGO_STATE_COLLECTION=app_state

# Used only when the database is empty and the backend creates the first account.
INITIAL_ADMIN_NAME=Kent Alteam
INITIAL_ADMIN_EMAIL=alteam.kbc@gmail.com
INITIAL_ADMIN_ROLE=admin
INITIAL_ADMIN_PASSWORD=change-this-before-live
DEV_PANEL_NAME=Developer
DEV_PANEL_EMAIL=developer@example.com
DEV_PANEL_ROLE=admin
DEV_PANEL_PASSWORD=change-this-before-live
DEV_PANEL_FORCE_PASSWORD=true

GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REDIRECT_URI=https://your-domain.com/api/integrations/gmail/callback
GMAIL_AUTO_SYNC=true
GMAIL_IMPORT=true
GMAIL_INCREMENTAL_ONLY=true
GMAIL_AUTO_SYNC_BATCH_SIZE=5
GMAIL_AUTO_SYNC_ACTIVE_MS=60000
GMAIL_AUTO_SYNC_IDLE_MS=300000
GMAIL_TRASH_SYNC_LIMIT=10
GMAIL_TRASH_SYNC_INTERVAL_MS=120000

# For password reset emails. With Gmail, use an App Password, not your normal Gmail password.
GMAIL_SMTP_USER=your-gmail-address@gmail.com
GMAIL_SMTP_PASS=your-gmail-app-password
GMAIL_SMTP_HOST=smtp.gmail.com
MAIL_FROM_NAME=Kent Business College
MAIL_FROM=your-gmail-address@gmail.com

EVENTBRITE_CLIENT_ID=your-eventbrite-api-key
EVENTBRITE_CLIENT_SECRET=your-eventbrite-client-secret
EVENTBRITE_REDIRECT_URI=https://your-domain.com/api/integrations/eventbrite/callback

# Optional fallback if Eventbrite OAuth pages are blocked for you.
# Create/copy a private OAuth token from Eventbrite and the app can sync directly.
EVENTBRITE_PRIVATE_TOKEN=your-eventbrite-private-token

META_ACCESS_TOKEN=your-meta-page-access-token
META_PAGE_ID=your-facebook-page-id
# Optional comma-separated form IDs. Leave empty to sync all lead forms on the page.
META_FORM_IDS=
META_GRAPH_VERSION=v22.0

APOLLO_API_KEY=your-apollo-api-key
# Optional comma-separated People Search filters.
APOLLO_KEYWORDS=apprenticeships training marketing project management
APOLLO_PERSON_TITLES=Marketing Manager,Sales Director,HR Manager,Learning and Development Manager
APOLLO_PERSON_LOCATIONS=United Kingdom
APOLLO_PER_PAGE=25
