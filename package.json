    "diagnose:monitoring:benchmark": "node scripts/monitoring-query-benchmark.js",
    "monitoring:snapshot": "node scripts/monitoring-snapshot-refresh.js",
    "test:monitoring:swr": "node scripts/monitoring-swr-test.js",
