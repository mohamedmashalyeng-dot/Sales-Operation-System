    "@types/node": "^20.17.10",
    "mongodb": "^6.20.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "^5.7.2",
    "xlsx": "^0.18.5"
