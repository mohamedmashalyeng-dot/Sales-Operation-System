{
  "name": "kent-business-college-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Kent Business College sales and admissions workspace backend.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:legacy": "node server.js",
    "test:security": "node scripts/security-static-smoke-test.js",
    "test:rocket": "node scripts/rocket-crud-static-audit.js",
    "check": "node --check server.js && node --check app.js && npm run test:security && npm run test:rocket && npm run build"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@types/node": "^20.17.10",
    "mongodb": "^6.20.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "^5.7.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9"
  },
  "engines": {
    "node": ">=18"
  }
}
